{
  "name": "astryx-native-starter",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export": "expo export",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "eas:login": "./node_modules/.bin/eas login",
    "eas:init": "./node_modules/.bin/eas init",
    "build:android": "./node_modules/.bin/eas build --platform android --profile preview",
    "build:ios": "./node_modules/.bin/eas build --platform ios --profile preview",
    "build:all": "./node_modules/.bin/eas build --platform all --profile preview",
    "update:preview": "./node_modules/.bin/eas update --channel preview --non-interactive",
    "update:production": "./node_modules/.bin/eas update --channel production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/abril-fatface": "^0.4.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/inclusive-sans": "^0.4.2",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.8",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^4.1.0",
    "uniwind": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "eas-cli": "^21.6.0",
    "playwright": "1.49.0",
    "typescript": "~5.9.2"
  }
}
