{
  "name": "healthy-tiffins-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx watch src/worker.ts",
    "jobs:run": "tsx src/jobs/run-once.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate --envPath .env up",
    "migrate:down": "node-pg-migrate --envPath .env down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "seed": "tsx src/platform/db/seed.ts",
    "db:reset": "tsx src/platform/db/reset.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@scalar/fastify-api-reference": "^1.25.108",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "luxon": "^3.5.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
