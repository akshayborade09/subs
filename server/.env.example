# Copy to .env for local development.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Homebrew Postgres uses 5432; the bundled docker-compose maps 5433.
DATABASE_URL=postgres://tiffins:tiffins@localhost:5432/tiffins

PUBLIC_BASE_URL=http://127.0.0.1:4000

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-plus-random-characters-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

MOCK_WEBHOOK_SECRET=mock-webhook-secret-dev-only

# Enables ?simulateState=, mock payment scenarios and OTP echo in responses.
# Must be false when NODE_ENV=production (enforced at boot).
ENABLE_DEV_ENDPOINTS=true

LOG_LEVEL=debug

# Integration tests point at a throwaway database:
#   createdb tiffins_test
#   DATABASE_URL=postgres://tiffins:tiffins@localhost:5432/tiffins_test pnpm db:test:setup
#   DATABASE_URL=postgres://tiffins:tiffins@localhost:5432/tiffins_test pnpm test:integration

# ── Razorpay (scaffold — not live) ───────────────────────────────────────────
# Leave PAYMENT_PROVIDER=mock until the agreement is signed. Setting it to
# razorpay without all three keys fails at boot, on purpose.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
