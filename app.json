{
  "expo": {
    "name": "Astryx Native",
    "slug": "astryx-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.astryxnative",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.astryxnative",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F0"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Astryx Native to use your location to choose a tiffin delivery address."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "012c987e-c45b-4857-84ae-9ac7d129b9ad"
      }
    },
    "owner": "akshayborade09"
  }
}
